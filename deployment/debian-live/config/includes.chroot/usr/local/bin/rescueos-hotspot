#!/bin/sh
set -eu
SSID="RESCUEOS-EMERGENCY"
echo "Available Wi-Fi interfaces:"
nmcli -t -f DEVICE,TYPE,STATE device | awk -F: '$2 == "wifi" {print $1 " (" $3 ")"}'
echo
printf "Wi-Fi interface to use (example: wlan0): "
read IFACE
printf "Hotspot password (at least 8 characters): "
stty -echo
read PASS
stty echo
echo
if [ "${#PASS}" -lt 8 ]; then
  echo "Password must be at least 8 characters." >&2
  exit 1
fi
exec nmcli device wifi hotspot ifname "$IFACE" ssid "$SSID" password "$PASS"
